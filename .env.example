# Database
# For local peer auth (macOS Homebrew PostgreSQL):
DATABASE_URL=postgresql://localhost:5432/clinicdesk
# For Docker or password auth:
# DATABASE_URL=postgresql://clinicdesk:clinicdesk@localhost:5432/clinicdesk

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# SendGrid
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=support@clinicdesk.com

# Google Calendar
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_CALENDAR_ID=primary

# App
APP_SECRET_KEY=change-me-in-production
APP_ENV=development
APP_PORT=8000
SUPPORT_TEAM_EMAIL=support@clinicdesk.com
